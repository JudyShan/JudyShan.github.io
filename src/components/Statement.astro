---
import { site } from '@config/site';

type StatementType =
  | 'theorem'
  | 'lemma'
  | 'proposition'
  | 'corollary'
  | 'definition'
  | 'remark'
  | 'fact'
  | 'proof';

interface Props {
  /** Mathematical statement type displayed in the heading. */
  type: StatementType;
  /** Optional statement number, for example "2.1". */
  number?: number | string;
  /** Optional descriptive title displayed in parentheses. */
  title?: string;
}

const { type, number, title } = Astro.props;
const label = type.charAt(0).toUpperCase() + type.slice(1);
const headingId = `statement-${Math.random().toString(36).slice(2, 9)}`;
const styled = site.features.statements;
---

<section
  class:list={['math-statement', { 'math-statement--plain': !styled }]}
  data-type={type}
  aria-labelledby={headingId}
>
  {
    type === 'proof' ? (
      <details class="proof-details">
        <summary class="math-statement-heading" id={headingId}>
          <span class="math-statement-label">
            {label}
            {number !== undefined && ` ${number}`}
          </span>
          {title && <span class="math-statement-title"> ({title})</span>}
        </summary>
        <div class="math-statement-body">
          <slot />
        </div>
      </details>
    ) : (
      <>
        <header class="math-statement-heading" id={headingId}>
          <span class="math-statement-label">
            {label}
            {number !== undefined && ` ${number}`}
          </span>
          {title && <span class="math-statement-title"> ({title})</span>}
        </header>
        <div class="math-statement-body">
          <slot />
        </div>
      </>
    )
  }
</section>

<style>
  .math-statement {
    --statement-accent: var(--global-theme-color);
    margin: 1.6rem 0;
    padding: 1rem 1.2rem;
    border: 1px solid var(--global-divider-color);
    border-left: 4px solid var(--statement-accent);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--statement-accent) 5%, var(--global-bg-color));
    color: var(--global-text-color);
  }

  .math-statement[data-type='definition'] {
    --statement-accent: var(--global-tip-block);
  }

  .math-statement[data-type='remark'],
  .math-statement[data-type='fact'],
  .math-statement[data-type='proof'] {
    --statement-accent: var(--global-text-color-light);
  }

  .math-statement--plain {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .math-statement-heading {
    margin-bottom: 0.65rem;
    line-height: 1.4;
  }

  .proof-details > summary {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-bottom: 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .proof-details > summary::-webkit-details-marker {
    display: none;
  }

  .proof-details > summary::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    margin-left: auto;
    border-right: 2px solid var(--statement-accent);
    border-bottom: 2px solid var(--statement-accent);
    transform: rotate(45deg);
    transition: transform 0.18s ease;
  }

  .proof-details[open] > summary {
    margin-bottom: 0.65rem;
  }

  .proof-details[open] > summary::after {
    transform: rotate(225deg);
  }

  .proof-details > summary:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--statement-accent);
    outline-offset: 0.25rem;
  }

  .math-statement-label {
    color: var(--statement-accent);
    font-family: var(--font-sans);
    font-size: 1.05em;
    font-variant: small-caps;
    font-weight: 700;
    letter-spacing: 0.025em;
  }

  .math-statement-title {
    font-weight: 600;
  }

  .math-statement[data-type='theorem'] .math-statement-body,
  .math-statement[data-type='lemma'] .math-statement-body,
  .math-statement[data-type='proposition'] .math-statement-body,
  .math-statement[data-type='corollary'] .math-statement-body {
    font-style: italic;
  }

  .math-statement-body :global(> :first-child) {
    margin-top: 0;
  }

  .math-statement-body :global(> :last-child) {
    margin-bottom: 0;
  }

  .math-statement-body :global(.math-display) {
    font-style: normal;
  }
</style>
