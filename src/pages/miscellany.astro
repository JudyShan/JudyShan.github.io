---
import MiscellanyCarousel from '@components/MiscellanyCarousel.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import { getCollection, render } from 'astro:content';

const items = (await getCollection('miscellany')).filter((item) => !item.data.hidden);

const renderedItems = await Promise.all(
  items.map(async (item) => ({ item, rendered: await render(item) })),
);

const hobbies = renderedItems
  .filter(({ item }) => item.data.section === 'hobbies')
  .sort((a, b) => {
    const byImportance = a.item.data.importance - b.item.data.importance;
    return byImportance || b.item.data.date.getTime() - a.item.data.date.getTime();
  });

const academicJourney = renderedItems
  .filter(({ item }) => item.data.section === 'academic')
  .sort((a, b) => {
    const byDate = a.item.data.date.getTime() - b.item.data.date.getTime();
    return byDate || a.item.data.importance - b.item.data.importance;
  });

const { miscellany } = site;
const { hobbies: hobbiesSection, academic: academicSection } = miscellany.sections;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<Page title={miscellany.title} description={miscellany.description}>
  <main class="miscellany-page">
    <header class="miscellany-hero">
      <p class="hero-eyebrow">{miscellany.eyebrow}</p>
      <h1>{miscellany.title}</h1>
      <p class="hero-description">{miscellany.description}</p>

      <nav class="section-nav" aria-label={miscellany.sectionNavLabel}>
        <a href={`#${hobbiesSection.id}`}>
          <span class="nav-number">{hobbiesSection.number}</span>
          <span>{hobbiesSection.title}</span>
          <span class="nav-arrow" aria-hidden="true">↓</span>
        </a>
        <a href={`#${academicSection.id}`}>
          <span class="nav-number">{academicSection.number}</span>
          <span>{academicSection.title}</span>
          <span class="nav-arrow" aria-hidden="true">↓</span>
        </a>
      </nav>
    </header>

    <section class="content-section" id={hobbiesSection.id}>
      <header class="section-heading">
        <span class="section-number">{hobbiesSection.number}</span>
        <div>
          <h2>{hobbiesSection.title}</h2>
          <p>{hobbiesSection.description}</p>
        </div>
      </header>

      {
        hobbies.length === 0 ? (
          <p class="empty-state">{hobbiesSection.emptyMessage}</p>
        ) : (
          <div class="hobby-grid">
            {hobbies.map(({ item, rendered: { Content } }) => (
              <article
                class:list={['hobby-card', item.data.images.length === 0 && 'without-image']}
              >
                {item.data.images.length > 0 && (
                  <MiscellanyCarousel
                    images={item.data.images}
                    title={item.data.title}
                    labels={miscellany.carouselLabels}
                    variant="hobby"
                  />
                )}

                <div class="hobby-body">
                  <div class="entry-meta">
                    {item.data.location && <span>{item.data.location}</span>}
                    <time datetime={item.data.date.toISOString()}>
                      {item.data.dateLabel ?? formatDate(item.data.date)}
                    </time>
                  </div>

                  <h3>{item.data.title}</h3>
                  {item.data.description && (
                    <p class="entry-description">{item.data.description}</p>
                  )}

                  <div class="entry-content">
                    <Content />
                  </div>

                  {item.data.links.length > 0 && (
                    <div class="entry-links">
                      {item.data.links.map((link) => (
                        <a href={withBase(link.url)} target="_blank" rel="noopener noreferrer">
                          <span>{link.label}</span>
                          <span aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }
    </section>

    <section class="content-section academic-section" id={academicSection.id}>
      <header class="section-heading">
        <span class="section-number">{academicSection.number}</span>
        <div>
          <h2>{academicSection.title}</h2>
          <p>{academicSection.description}</p>
        </div>
      </header>

      {
        academicJourney.length === 0 ? (
          <p class="empty-state">{academicSection.emptyMessage}</p>
        ) : (
          <div class="academic-timeline">
            {academicJourney.map(({ item, rendered: { Content } }) => (
              <div class="timeline-entry">
                <div class="timeline-date">
                  <time datetime={item.data.date.toISOString()}>
                    {item.data.dateLabel ?? formatDate(item.data.date)}
                  </time>
                </div>
                <div class="timeline-marker" aria-hidden="true">
                  <span />
                </div>

                <article class="timeline-card">
                  <div
                    class:list={[
                      'timeline-card-layout',
                      item.data.images.length > 0 && 'has-media',
                    ]}
                  >
                    {item.data.images.length > 0 && (
                      <MiscellanyCarousel
                        images={item.data.images}
                        title={item.data.title}
                        labels={miscellany.carouselLabels}
                        variant="timeline"
                      />
                    )}

                    <div class="timeline-body">
                      <div class="entry-meta">
                        {item.data.category && <span>{item.data.category}</span>}
                        {item.data.location && <span>{item.data.location}</span>}
                      </div>

                      <h3>{item.data.title}</h3>
                      {item.data.description && (
                        <p class="entry-description">{item.data.description}</p>
                      )}

                      <div class="entry-content">
                        <Content />
                      </div>

                      {item.data.links.length > 0 && (
                        <div class="entry-links">
                          {item.data.links.map((link) => (
                            <a href={withBase(link.url)} target="_blank" rel="noopener noreferrer">
                              <span>{link.label}</span>
                              <span aria-hidden="true">↗</span>
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        )
      }
    </section>
  </main>
</Page>

<style>
  .miscellany-page {
    padding-bottom: 3rem;
  }

  .miscellany-hero {
    padding: clamp(2rem, 6vw, 5rem) 0 clamp(2.5rem, 6vw, 4.75rem);
  }

  .hero-eyebrow {
    color: var(--global-theme-color);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin: 0 0 0.8rem;
    text-transform: uppercase;
  }

  .miscellany-hero h1 {
    color: var(--global-text-color);
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 7vw, 5.4rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
  }

  .hero-description {
    color: var(--global-text-color-light);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.65;
    margin: 1.35rem 0 0;
    max-width: 680px;
  }

  .section-nav {
    border-bottom: 1px solid var(--global-divider-color);
    border-top: 1px solid var(--global-divider-color);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .section-nav a {
    align-items: center;
    color: var(--global-text-color);
    display: grid;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 650;
    gap: 0.9rem;
    grid-template-columns: auto 1fr auto;
    padding: 1rem 0;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .section-nav a + a {
    border-left: 1px solid var(--global-divider-color);
    padding-left: 1.25rem;
  }

  .section-nav a:first-child {
    padding-right: 1.25rem;
  }

  .section-nav a:hover {
    color: var(--global-theme-color);
  }

  .nav-number {
    color: var(--global-text-color-light);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .nav-arrow {
    font-size: 1rem;
    transition: transform 160ms ease;
  }

  .section-nav a:hover .nav-arrow {
    transform: translateY(3px);
  }

  .content-section {
    padding: clamp(2.5rem, 6vw, 4.75rem) 0;
    scroll-margin-top: calc(var(--navbar-height) + 1rem);
  }

  .academic-section {
    border-top: 1px solid var(--global-divider-color);
  }

  .section-heading {
    align-items: start;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .section-number {
    color: var(--global-theme-color);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    padding-top: 0.45rem;
  }

  .section-heading h2 {
    color: var(--global-text-color);
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0;
  }

  .section-heading p {
    color: var(--global-text-color-light);
    line-height: 1.6;
    margin: 0.65rem 0 0;
    max-width: 620px;
  }

  .hobby-grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.6rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hobby-card,
  .timeline-card {
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 14px;
    overflow: hidden;
  }

  .hobby-card {
    min-width: 0;
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .hobby-card:hover {
    border-color: color-mix(in srgb, var(--global-theme-color) 45%, var(--global-divider-color));
    transform: translateY(-3px);
  }

  .hobby-body {
    padding: clamp(1.15rem, 3vw, 1.55rem);
  }

  .entry-meta {
    align-items: center;
    color: var(--global-text-color-light);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    gap: 0.55rem;
    letter-spacing: 0.055em;
    margin-bottom: 0.65rem;
    text-transform: uppercase;
  }

  .entry-meta > * + *::before {
    color: var(--global-theme-color);
    content: '·';
    margin-right: 0.55rem;
  }

  .hobby-card h3,
  .timeline-card h3 {
    color: var(--global-text-color);
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 680;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
  }

  .entry-description {
    color: var(--global-text-color-light);
    font-size: 0.94rem;
    line-height: 1.55;
    margin: 0.55rem 0 0;
  }

  .entry-content :global(p) {
    color: var(--global-text-color);
    font-size: 0.94rem;
    line-height: 1.65;
    margin: 0.7rem 0 0;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .entry-links a {
    align-items: center;
    color: var(--global-theme-color);
    display: inline-flex;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 650;
    gap: 0.35rem;
    text-decoration: none;
  }

  .entry-links a:hover {
    color: var(--global-hover-color);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .academic-timeline {
    --timeline-date-width: 7.5rem;
    --timeline-marker-width: 1.15rem;
    display: grid;
    gap: 1.5rem;
    position: relative;
  }

  .academic-timeline::before {
    background: var(--global-divider-color);
    bottom: 1rem;
    content: '';
    left: calc(var(--timeline-date-width) + (var(--timeline-marker-width) / 2));
    position: absolute;
    top: 1rem;
    width: 1px;
  }

  .timeline-entry {
    align-items: start;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: var(--timeline-date-width) var(--timeline-marker-width) minmax(0, 1fr);
    position: relative;
  }

  .timeline-date {
    color: var(--global-text-color-light);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    line-height: 1.35;
    padding-top: 1rem;
    text-align: right;
  }

  .timeline-marker {
    display: flex;
    justify-content: center;
    padding-top: 1.15rem;
    position: relative;
    z-index: 1;
  }

  .timeline-marker span {
    background: var(--global-bg-color);
    border: 2px solid var(--global-theme-color);
    border-radius: 50%;
    display: block;
    height: 0.7rem;
    width: 0.7rem;
  }

  .timeline-card-layout.has-media {
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1.28fr);
  }

  .timeline-body {
    padding: clamp(1.2rem, 3vw, 1.7rem);
  }

  .empty-state {
    background: var(--global-card-bg-color);
    border: 1px dashed var(--global-divider-color);
    border-radius: 12px;
    color: var(--global-text-color-light);
    margin: 0;
    padding: 1.4rem;
  }

  @media (max-width: 720px) {
    .miscellany-hero {
      padding-top: 2.5rem;
    }

    .section-nav {
      grid-template-columns: 1fr;
    }

    .section-nav a:first-child {
      padding-right: 0;
    }

    .section-nav a + a {
      border-left: 0;
      border-top: 1px solid var(--global-divider-color);
      padding-left: 0;
    }

    .hobby-grid {
      grid-template-columns: 1fr;
    }

    .academic-timeline {
      --timeline-marker-width: 1rem;
      gap: 1.8rem;
    }

    .academic-timeline::before {
      left: calc(var(--timeline-marker-width) / 2);
    }

    .timeline-entry {
      grid-template-columns: var(--timeline-marker-width) minmax(0, 1fr);
    }

    .timeline-date {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0;
      text-align: left;
    }

    .timeline-marker {
      grid-column: 1;
      grid-row: 1 / span 2;
      padding-top: 0.15rem;
    }

    .timeline-card {
      grid-column: 2;
      grid-row: 2;
    }

    .timeline-card-layout.has-media {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hobby-card,
    .nav-arrow {
      transition: none;
    }
  }
</style>
