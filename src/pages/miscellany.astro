---
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import { getCollection, render } from 'astro:content';

const items = (await getCollection('miscellany'))
  .filter((item) => !item.data.hidden)
  .sort((a, b) => {
    const byDate = b.data.date.getTime() - a.data.date.getTime();
    if (byDate !== 0) return byDate;
    return (a.data.importance ?? 999) - (b.data.importance ?? 999);
  });

const renderedItems = await Promise.all(
  items.map(async (item) => ({ item, rendered: await render(item) })),
);

const byYear = new Map<number, typeof renderedItems>();
for (const item of renderedItems) {
  const year = item.item.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(item);
}

const years = [...byYear.keys()].sort((a, b) => b - a);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Page
  title="Miscellany"
  description="Visits, schools, notes, and small fragments outside the paper trail."
>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">miscellany</h1>
      <p class="post-description">
        Visits, schools, notes, and small fragments outside the paper trail.
      </p>
    </header>

    <article>
      {
        renderedItems.length === 0 ? (
          <p class="empty">No miscellany items yet.</p>
        ) : (
          years.map((year) => (
            <section class="year-section">
              <h2 class="year-label">{year}</h2>
              <div class="entry-list">
                {byYear.get(year)!.map(({ item, rendered: { Content } }) => (
                  <article class="entry">
                    {item.data.image && (
                      <figure class="entry-media">
                        <img
                          src={withBase(item.data.image)}
                          alt={item.data.imageAlt ?? item.data.title}
                          loading="lazy"
                        />
                      </figure>
                    )}

                    <div class="entry-body">
                      <div class="entry-meta">
                        <time datetime={item.data.date.toISOString()}>
                          {item.data.dateLabel ?? formatDate(item.data.date)}
                        </time>
                        {item.data.category && <span>{item.data.category}</span>}
                        {item.data.location && <span>{item.data.location}</span>}
                      </div>

                      <h3>{item.data.title}</h3>
                      {item.data.description && (
                        <p class="entry-description">{item.data.description}</p>
                      )}

                      <div class="entry-content">
                        <Content />
                      </div>

                      {item.data.links.length > 0 && (
                        <div class="entry-links">
                          {item.data.links.map((link) => (
                            <a href={withBase(link.url)} target="_blank" rel="noopener noreferrer">
                              {link.label}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))
        )
      }
    </article>
  </div>
</Page>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-title {
    color: var(--global-text-color);
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .post-description,
  .empty {
    color: var(--global-text-color-light);
  }

  .year-section {
    margin-bottom: 2.5rem;
  }

  .year-label {
    border-bottom: 1px solid var(--global-divider-color);
    color: var(--global-text-color);
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 1rem;
    padding-bottom: 0.3rem;
  }

  .entry-list {
    display: grid;
    gap: 1.4rem;
  }

  .entry {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 180px) 1fr;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .entry-media {
    margin: 0;
  }

  .entry-media img {
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .entry-body {
    min-width: 0;
  }

  .entry-meta {
    color: var(--global-text-color-light);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.82rem;
    gap: 0.45rem;
    margin-bottom: 0.25rem;
  }

  .entry-meta span::before {
    content: '/';
    margin-right: 0.45rem;
    color: var(--global-divider-color);
  }

  .entry h3 {
    color: var(--global-text-color);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 650;
    margin: 0 0 0.35rem;
  }

  .entry-description,
  .entry-content :global(p) {
    color: var(--global-text-color);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0.35rem 0;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.6rem;
  }

  .entry-links a {
    color: var(--global-theme-color);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .entry-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 1fr;
    }

    .entry-media img {
      max-height: 260px;
    }
  }
</style>
